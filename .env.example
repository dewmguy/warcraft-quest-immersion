WQI_ADMIN_USER=admin
# Leave blank when authentication is enforced by Pangolin SSO.
WQI_ADMIN_PASSWORD=
WQI_WEB_PORT=8090
WQI_DATA_DIR=/app/data

MYSQL_HOST=warcraft-quest-db
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=CHANGE_ME_TOO
MYSQL_USER=warcraft
MYSQL_PASSWORD=CHANGE_ME_TOO
MYSQL_DATABASE=mangos

# On-demand AzerothCore world snapshot used only by `wqi corpus extract`.
# The Compose service has no published ports and is excluded from normal startup.
AZEROTHCORE_MYSQL_HOST=warcraft-quest-source-db
AZEROTHCORE_MYSQL_PORT=3306
AZEROTHCORE_MYSQL_USER=root
AZEROTHCORE_MYSQL_PASSWORD=CHANGE_ME_SOURCE_DB
AZEROTHCORE_MYSQL_DATABASE=acore_world

# Optional until you generate audio.
ELEVENLABS_API_KEY=
